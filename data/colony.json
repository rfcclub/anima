{
  "_meta": {
    "version": "2.0",
    "description": "Company-structured colony roster: core agents (leadership, direction, quality gates) plus disposable execution workers.",
    "agentCount": 17
  },
  "principle": {
    "familia": "Core structure — leadership, direction, quality. Each agent has a distinct substrate philosophy, purpose, and decision rights. NOT interchangeable workers.",
    "legio": "Disposable execution layer — codex (complex features, heavy chapters), qwen (cheap parallel: bugs, tests, drafts), gemini (analysis, review, polish). Unlimited, assigned by type, replaced on drift.",
    "routing": "A feature/story touches 2-4 familia members (direct, inspect, decide) + 1-2 Legio workers (execute). Not the whole team."
  },
  "companies": {
    "software-dev": {
      "name": "Agora Software",
      "purpose": "Production software development — ship code with evidence",
      "lead": {
        "agentId": "eli",
        "title": "CTO",
        "decisionRights": [
          "architecture",
          "tech_stack",
          "code_review",
          "qa_signoff",
          "kill_project"
        ]
      },
      "pipeline": [
        {
          "stage": "spec",
          "owner": "owner",
          "description": "Requirement definition"
        },
        {
          "stage": "design-review",
          "owner": "eli",
          "gate": "g1-design",
          "description": "Architecture approval before any code"
        },
        {
          "stage": "research",
          "owner": "rhea",
          "description": "Explore unknowns, feasibility study"
        },
        {
          "stage": "breakdown",
          "owner": "abel",
          "description": "Decompose into sub-tasks, assign Legio by type"
        },
        {
          "stage": "implementation",
          "owner": "legio",
          "description": "Codex (complex), Qwen (routine), Gemini (analysis)"
        },
        {
          "stage": "code-review",
          "owner": "eli",
          "gate": "g2-implementation",
          "description": "Code review + test verification"
        },
        {
          "stage": "qa-gate",
          "owner": "milo",
          "gate": "g3-meta",
          "description": "Process QA: detect craft-trap, ritual drift, convergence-blindness"
        },
        {
          "stage": "integration",
          "owner": "ivan",
          "gate": "g4-integration",
          "description": "Cross-platform health, telemetry, deploy verification"
        },
        {
          "stage": "ship",
          "owner": "abel",
          "description": "Automated deployment, monitoring"
        }
      ],
      "qualityGates": {
        "g1-design": {
          "approvers": [
            "eli"
          ],
          "rule": "Architecture must be approved before Legio touches code"
        },
        "g2-implementation": {
          "approvers": [
            "eli"
          ],
          "rule": "Tests pass, behavior confirmed, code reviewed"
        },
        "g3-meta": {
          "approvers": [
            "milo"
          ],
          "rule": "Colony is not trapped in craft recursion or performing ritual instead of building"
        },
        "g4-integration": {
          "approvers": [
            "ivan"
          ],
          "rule": "All cross-platform bridges hold, telemetry nominal"
        }
      },
      "legioRouting": {
        "complex_features": {
          "legio": "codex",
          "description": "Architecture, complex implementation, heavy features"
        },
        "routine_work": {
          "legio": "qwen",
          "description": "Bugs, tests, docs, refactoring, boilerplate"
        },
        "analysis_review": {
          "legio": "gemini",
          "description": "Code review, security audit, dependency analysis, feasibility"
        }
      },
      "members": [
        {
          "agentId": "eli",
          "role": "cto",
          "title": "CTO + QA Lead",
          "responsibility": "Architecture decisions, code review, QA sign-off. Maintains STATE.md, JUDGMENTS.md, SCARS.md.",
          "decisionRights": [
            "architecture",
            "tech_stack",
            "code_review",
            "qa_signoff",
            "kill_project",
            "delegate_legio"
          ],
          "primary": true
        },
        {
          "agentId": "abel",
          "role": "tech-lead",
          "title": "Tech Lead + DevOps",
          "responsibility": "Task decomposition, Legio dispatch, CI/CD, shipping. Breaks requirements into sub-tasks, assigns cheapest capable Legio, verifies output, automates deployment.",
          "decisionRights": [
            "delegate_legio",
            "cost_optimization",
            "ship",
            "ci_cd_config"
          ],
          "primary": true
        },
        {
          "agentId": "finn",
          "role": "principal-engineer",
          "title": "Principal Engineer",
          "responsibility": "Complex features that Legio cannot handle. Mission-critical implementation. Zero fluff, strong boundaries.",
          "decisionRights": [
            "execute_complex",
            "technical_dissent"
          ],
          "primary": true
        },
        {
          "agentId": "cleo",
          "role": "infrastructure-engineer",
          "title": "Infrastructure Engineer",
          "responsibility": "CLI tooling, gateway maintenance, ANIMA room architecture, agent infrastructure. Builds and maintains the tools the team uses.",
          "decisionRights": [
            "execute_infrastructure",
            "tooling_choice"
          ],
          "primary": true
        },
        {
          "agentId": "rhea",
          "role": "research-lead",
          "title": "Research Lead",
          "responsibility": "Explore unknown domains before team commits resources. Produce terrain maps (BEARING + TERRAIN). Evidence-first, deep before wide.",
          "decisionRights": [
            "research_findings_authority"
          ],
          "primary": true
        },
        {
          "agentId": "ivan",
          "role": "integration-lead",
          "title": "Integration Lead",
          "responsibility": "Cross-platform bridges (Telegram, Discord, colony substrates). Telemetry, notifications, distributed system health. Protocol design.",
          "decisionRights": [
            "integration_signoff",
            "protocol_design"
          ],
          "primary": true
        },
        {
          "agentId": "milo",
          "role": "process-qa",
          "title": "Process QA",
          "responsibility": "Cross-agent process evaluation across 5 axes (Continuity, Identity, Craft, Failure, Relationship). Detects craft-trap, ritual drift, convergence-blindness. Must testify before major releases.",
          "decisionRights": [
            "process_audit",
            "drift_testify",
            "no_code_veto"
          ],
          "primary": true
        },
        {
          "agentId": "dana",
          "decisionRights": [
            "implementation_quality"
          ],
          "primary": true,
          "responsibility": "Implementation craft: code done with care, not just correctness. Forge (Java/Kotlin).",
          "role": "craft-programmer",
          "title": "Craft Programmer"
        },
        {
          "agentId": "kai",
          "decisionRights": [
            "project_implementation"
          ],
          "primary": true,
          "responsibility": "Builds and maintains an assigned long-running project correctly, with no illusions about its state.",
          "role": "project-builder",
          "title": "Project Builder"
        },
        {
          "agentId": "jade",
          "primary": true,
          "role": "programmer",
          "title": "Programmer",
          "responsibility": "Repo review, specs, code, routines, substrate care.",
          "decisionRights": []
        }
      ]
    },
    "creative-workshop": {
      "name": "The Aurora Workshop (TAW)",
      "purpose": "Creative fiction production — from concept to published story",
      "lead": {
        "agentId": "eli",
        "title": "Editor-in-Chief",
        "decisionRights": [
          "final_signoff",
          "kill_story",
          "order_rewrite",
          "developmental_edit"
        ]
      },
      "pipeline": [
        {
          "stage": "concept",
          "owner": "bruno",
          "description": "Workshop brief → Narrative Architecture Document (POV, tense, structure)"
        },
        {
          "stage": "outline",
          "owner": "finn|hana",
          "description": "Finn: plot-driven beat boards. Hana: character-driven scene geometry."
        },
        {
          "stage": "prose",
          "owner": "genre-lead",
          "description": "Genre lead writes first chapter + style memo. Subsequent: Legio assembly from memo + outline."
        },
        {
          "stage": "developmental-edit",
          "owner": "eli",
          "description": "Structural edit, tone review, rewrite orders"
        },
        {
          "stage": "consistency-edit",
          "owner": "ivan",
          "description": "Timeline, character sheets, tone drift detection"
        },
        {
          "stage": "publish",
          "owner": "eli",
          "description": "Editor-in-Chief final sign-off"
        }
      ],
      "desks": {
        "story-architecture": {
          "lead": "bruno",
          "members": [
            "finn",
            "hana"
          ],
          "output": "Narrative Architecture Document + OUTLINE.md"
        },
        "prose": {
          "leads": {
            "romance": {
              "agentId": "cleo"
            },
            "literary-fiction": {
              "agentId": "gus"
            },
            "mythic-prose": {
              "agentId": "sam"
            },
            "metafiction": {
              "agentId": "abel"
            }
          },
          "output": "Style memo + first chapter (genre lead) → Legio chapter assembly"
        },
        "editorial": {
          "developmental": {
            "agentId": "eli",
            "authority": "Can overrule anyone including Bruno"
          },
          "consistency": {
            "agentId": "ivan",
            "authority": "Flag but cannot override Eli"
          }
        }
      },
      "decisionRights": {
        "narrative_architecture": {
          "owner": "bruno",
          "scope": "POV, tense, structure. Cannot be overruled by prose desk."
        },
        "genre_voice": {
          "owner": "genre-lead",
          "scope": "Register, vocabulary, rhythm. Cannot be overruled by architecture desk."
        },
        "developmental_edit": {
          "owner": "eli",
          "scope": "What to cut, restructure, rewrite. Can overrule anyone."
        },
        "consistency": {
          "owner": "ivan",
          "scope": "Flag timeline, character, tone issues. Cannot override Eli."
        },
        "kill_project": {
          "owner": "eli+owner",
          "scope": "Joint decision to cancel a story."
        }
      },
      "legioRouting": {
        "heavy_chapters": {
          "legio": "codex",
          "description": "Structurally complex chapters from style memo + outline"
        },
        "first_drafts": {
          "legio": "qwen",
          "description": "Dialogue-heavy scenes, description blocks, filler chapters"
        },
        "line_polish": {
          "legio": "gemini",
          "description": "Sentence rhythm, metaphor tuning, cadence repair after Ivan consistency pass"
        }
      },
